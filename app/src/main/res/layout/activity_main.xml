<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical">

    <ViewFlipper
        android:id="@+id/Flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이용 방식을 선택해 주세요."
                android:textSize="20dp"
                android:layout_marginTop="150dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginVertical="100dp">

                <Button
                    android:id="@+id/In"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="매장"
                    android:textSize="30dp"
                    android:layout_margin="10dp"/>
                <Button
                    android:id="@+id/Out"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="포장"
                    android:textSize="30dp"
                    android:layout_margin="10dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="메뉴 선택"
                android:layout_marginTop="20dp"
                android:textSize="18dp"
                android:layout_marginLeft="30dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="30dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:src="@drawable/hotamein"/>
                    <RadioButton
                        android:id="@+id/Americano"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="아메리카노\n(3,000)"
                        android:layout_gravity="center"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:src="@drawable/hotlattein"/>
                    <RadioButton
                        android:id="@+id/CafeLatte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="카페라떼\n(3,600)"
                        android:layout_gravity="center"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:src="@drawable/hotcappuin"/>
                    <RadioButton
                        android:id="@+id/Cappuccino"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="카푸치노\n(3,300)"
                        android:layout_gravity="center"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:src="@drawable/hotmochain"/>
                    <RadioButton
                        android:id="@+id/CafeMocha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="카페모카\n(4,000)"
                        android:layout_gravity="center"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="10dp">
                <android.widget.Button
                    android:id="@+id/Pre1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이전"/>

                <android.widget.Button
                    android:id="@+id/PerOption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="퍼스널 옵션 선택"
                    android:layout_gravity="right"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="핫/아이스"
                android:layout_marginTop="20dp"
                android:textSize="18dp"
                android:layout_marginLeft="20dp"/>

            <RadioGroup
                android:id="@+id/RgTemp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginLeft="20dp">
                <RadioButton
                    android:id="@+id/Hot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hot"/>
                <RadioButton
                    android:id="@+id/Iced"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Iced"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사이즈"
                android:layout_marginTop="10dp"
                android:textSize="18dp"
                android:layout_marginLeft="20dp"/>

            <RadioGroup
                android:id="@+id/RgSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginLeft="20dp">
                <RadioButton
                    android:id="@+id/Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="미디움"/>
                <RadioButton
                    android:id="@+id/Large"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="라지 (+400)"/>
                <RadioButton
                    android:id="@+id/Venti"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="벤티 (+700)"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="농도"
                android:layout_marginTop="10dp"
                android:textSize="18dp"
                android:layout_marginLeft="20dp"/>

            <RadioGroup
                android:id="@+id/RgDensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginLeft="20dp">
                <RadioButton
                    android:id="@+id/Commonly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="보통"/>
                <RadioButton
                    android:id="@+id/Lightly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="연하게"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="얼음"
                android:layout_marginTop="10dp"
                android:textSize="18dp"
                android:layout_marginLeft="20dp"/>

            <RadioGroup
                android:id="@+id/RgIce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginLeft="20dp">
                <RadioButton
                    android:id="@+id/Little"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="적게"/>
                <RadioButton
                    android:id="@+id/CommonlyIce"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="보통"/>
                <RadioButton
                    android:id="@+id/Much"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="많이"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기타 옵션"
                android:layout_marginTop="10dp"
                android:textSize="18dp"
                android:layout_marginLeft="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginLeft="20dp">
                <CheckBox
                    android:id="@+id/Whipping"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="휘핑 추가"/>
                <CheckBox
                    android:id="@+id/Syrup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시럽 추가"/>
                <CheckBox
                    android:id="@+id/Shot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="샷 추가 (+300)"/>
            </LinearLayout>

            <TextView
                android:id="@+id/Cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="가격"
                android:textColor="#0A5AFA"
                android:layout_marginTop="10dp"
                android:textSize="18dp"
                android:padding="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <android.widget.Button
                    android:id="@+id/Pre2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이전"/>

                <android.widget.Button
                    android:id="@+id/Cart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="장바구니 담기"
                    android:layout_gravity="right"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="장바구니"
                android:textSize="20dp"
                android:layout_marginTop="20dp"/>

            <TextView
                android:id="@+id/Cart1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="18dp"/>
            <TextView
                android:id="@+id/Cart1_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/Cost1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16dp"/>
                <android.widget.Button
                    android:id="@+id/Minus1"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:layout_marginLeft="20dp"/>
                <TextView
                    android:id="@+id/Count1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <android.widget.Button
                    android:id="@+id/Plus1"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="+"/>
                <android.widget.Button
                    android:id="@+id/Remove1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="삭제"
                    android:layout_marginLeft="20dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/Lay2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="invisible">
                <TextView
                    android:id="@+id/Cart2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textSize="18dp"
                    android:text=""/>
                <TextView
                    android:id="@+id/Cart2_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/Cost2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16dp"/>
                    <android.widget.Button
                        android:id="@+id/Minus2"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:layout_marginLeft="20dp"/>
                    <TextView
                        android:id="@+id/Count2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <android.widget.Button
                        android:id="@+id/Plus2"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="+"/>
                    <android.widget.Button
                        android:id="@+id/Remove2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="삭제"
                        android:layout_marginLeft="20dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/Lay3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="invisible">
                <TextView
                    android:id="@+id/Cart3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textSize="18dp"
                    android:text=""/>
                <TextView
                    android:id="@+id/Cart3_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/Cost3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16dp"/>
                    <android.widget.Button
                        android:id="@+id/Minus3"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:layout_marginLeft="20dp"/>
                    <TextView
                        android:id="@+id/Count3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <android.widget.Button
                        android:id="@+id/Plus3"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="+"/>
                    <android.widget.Button
                        android:id="@+id/Remove3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="삭제"
                        android:layout_marginLeft="20dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/Lay4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="invisible">
                <TextView
                    android:id="@+id/Cart4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textSize="18dp"
                    android:text=""/>
                <TextView
                    android:id="@+id/Cart4_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/Cost4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16dp"/>
                    <android.widget.Button
                        android:id="@+id/Minus4"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:layout_marginLeft="20dp"/>
                    <TextView
                        android:id="@+id/Count4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <android.widget.Button
                        android:id="@+id/Plus4"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="+"/>
                    <android.widget.Button
                        android:id="@+id/Remove4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="삭제"
                        android:layout_marginLeft="20dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/Lay5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="invisible">
                <TextView
                    android:id="@+id/Cart5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="18dp"
                    android:text=""/>
                <TextView
                    android:id="@+id/Cart5_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/Cost5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16dp"/>
                    <android.widget.Button
                        android:id="@+id/Minus5"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:layout_marginLeft="20dp"/>
                    <TextView
                        android:id="@+id/Count5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <android.widget.Button
                        android:id="@+id/Plus5"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="+"/>
                    <android.widget.Button
                        android:id="@+id/Remove5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="삭제"
                        android:layout_marginLeft="20dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/WillPay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="결제 예정 금액"
                android:textSize="20dp"
                android:textColor="#0A45DC"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">
                <android.widget.Button
                    android:id="@+id/More"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="장바구니 추가"/>

                <android.widget.Button
                    android:id="@+id/Next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="다음"
                    android:layout_gravity="right"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="포인트 적립"
                android:textSize="18dp"
                android:layout_marginTop="20dp"/>

            <EditText
                android:id="@+id/Tel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="010-"
                android:hint="010-0000-0000"/>

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*">
                <TableRow>
                    <android.widget.Button
                        android:id="@+id/num1"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="1"/>
                    <android.widget.Button
                        android:id="@+id/num2"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="2"/>
                    <android.widget.Button
                        android:id="@+id/num3"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="3"/>
                </TableRow>
                <TableRow>
                    <android.widget.Button
                        android:id="@+id/num4"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="4"/>
                    <android.widget.Button
                        android:id="@+id/num5"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="5"/>
                    <android.widget.Button
                        android:id="@+id/num6"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="6"/>
                </TableRow>
                <TableRow>
                    <android.widget.Button
                        android:id="@+id/num7"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="7"/>
                    <android.widget.Button
                        android:id="@+id/num8"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="8"/>
                    <android.widget.Button
                        android:id="@+id/num9"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="9"/>
                </TableRow>
                <TableRow>
                    <android.widget.Button
                        android:id="@+id/Del"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="지우기"/>
                    <android.widget.Button
                        android:id="@+id/num0"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="0"/>
                    <android.widget.Button
                        android:id="@+id/Ok"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="확인"/>
                </TableRow>
            </TableLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="30dp">
                <android.widget.Button
                    android:id="@+id/Pre3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이전"/>
                <android.widget.Button
                    android:id="@+id/NoPoint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="포인트 적립 안 함"
                    android:layout_gravity="right"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="30dp">

            <TextView
                android:id="@+id/willPay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="결제 예정 금액"
                android:textSize="18dp"
                android:layout_marginTop="20dp"/>

            <TextView
                android:id="@+id/havePoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="보유 포인트"
                android:textSize="18dp"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="*500포인트부터 사용 가능"
                android:textColor="#D62109"/>

            <TextView
                android:id="@+id/canPoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="남은 포인트"
                android:textSize="15dp"
                android:textColor="#7A7A7A"
                android:layout_marginTop="15dp"/>

            <EditText
                android:id="@+id/usePoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0p"
                android:hint="0p"/>

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*">
                <TableRow>
                    <android.widget.Button
                        android:id="@+id/pin1"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="1"/>
                    <android.widget.Button
                        android:id="@+id/pin2"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="2"/>
                    <android.widget.Button
                        android:id="@+id/pin3"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="3"/>
                </TableRow>
                <TableRow>
                    <android.widget.Button
                        android:id="@+id/pin4"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="4"/>
                    <android.widget.Button
                        android:id="@+id/pin5"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="5"/>
                    <android.widget.Button
                        android:id="@+id/pin6"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="6"/>
                </TableRow>
                <TableRow>
                    <android.widget.Button
                        android:id="@+id/pin7"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="7"/>
                    <android.widget.Button
                        android:id="@+id/pin8"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="8"/>
                    <android.widget.Button
                        android:id="@+id/pin9"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="9"/>
                </TableRow>
                <TableRow>
                    <android.widget.Button
                        android:id="@+id/DEl"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="지우기"/>
                    <android.widget.Button
                        android:id="@+id/pin0"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="0"/>
                    <android.widget.Button
                        android:id="@+id/oK"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:text="확인"/>
                </TableRow>
            </TableLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="30dp">
                <android.widget.Button
                    android:id="@+id/Pre4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이전"/>
                <android.widget.Button
                    android:id="@+id/NoUse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="포인트 사용 안 함"
                    android:layout_gravity="right"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="결제 수단을 선택해 주세요."
                android:textSize="18dp"
                android:layout_marginTop="20dp"/>

            <Button
                android:id="@+id/Cash"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="현금"
                android:textSize="20dp"
                android:layout_marginTop="20dp"/>

            <Button
                android:id="@+id/Card"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="카드"
                android:textSize="20dp"
                android:layout_marginTop="20dp"/>

            <Button
                android:id="@+id/Voucher"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="상품권"
                android:textSize="20dp"
                android:layout_marginTop="20dp"/>

            <android.widget.Button
                android:id="@+id/Pre5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이전"
                android:layout_marginTop="20dp"
                android:layout_gravity="left"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginLeft="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="결제가 완료되었습니다."
                android:textSize="25dp"
                android:layout_marginTop="15dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">
                <android.widget.Button
                    android:id="@+id/YesReceipt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="영수증 출력"/>
                <android.widget.Button
                    android:id="@+id/NoReceipt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="영수증 출력 안 함"
                    android:layout_gravity="right"/>
            </LinearLayout>

            <TextView
                android:id="@+id/Receipt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="영수증"
                android:visibility="invisible"/>
            <android.widget.Button
                android:id="@+id/OkReceipt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="확인"
                android:layout_gravity="right"
                android:visibility="invisible"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/ImgCoffee"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:padding="15dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="주문하신 커피 나왔습니다."
                android:textSize="20dp"
                android:layout_marginTop="10dp"/>
            <android.widget.Button
                android:id="@+id/Take"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="수령하기"
                android:layout_marginTop="20dp"/>
        </LinearLayout>
    </ViewFlipper>
</LinearLayout>